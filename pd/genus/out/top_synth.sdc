set sdc_version 2.0

set_units -capacitance 1fF
set_units -time 1ps

# Set the current design
current_design top

create_clock -name "core_clock" -period 2000.0 -waveform {0.0 1000.0} [get_ports in_clka]
set_clock_gating_check -setup 0.0 
set_input_delay -clock [get_clocks core_clock] -add_delay 400.0 [get_ports in_clkb]
set_input_delay -clock [get_clocks core_clock] -add_delay 400.0 [get_ports in_restart]
